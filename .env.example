# 한국투자증권 OpenAPI 접속 정보.
#
# 이 파일을 .env 로 복사해서 값을 채우세요.
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
#
# .env 는 .gitignore에 있어 커밋되지 않습니다. 절대 공유하지 마세요.
# 키는 KIS Developers(apiportal.koreainvestment.com)에서 발급합니다.
# **모의투자용 키와 실전용 키는 서로 다릅니다.** 섞어 쓰면 인증이 깨집니다.

KIS_APP_KEY=
KIS_APP_SECRET=

# 계좌번호는 '50214588-01' 처럼 적힙니다.
#   KIS_ACCOUNT      = 하이픈 앞부분 전체(8자리). 쪼개지 마세요.
#   KIS_PRODUCT_CODE = 하이픈 뒷부분(2자리). 종합위탁은 보통 01.
# 8자리만 보이면 끝 두 자리를 떼어 옮기지 말고, 상품코드는 01로 두세요.
KIS_ACCOUNT=12345678
KIS_PRODUCT_CODE=01

# 모의투자 여부. 기본값은 true(모의).
# 실계좌로 실제 돈을 굴리려면 이 값을 false 로 **직접** 바꿔야 합니다.
# 그때부터 주문 제출 전에 확인 절차가 생깁니다.
KIS_PAPER=true
